ansible/logs/
.DS_Store

# ---- Claude Code transient session state ------------------------------------
.claude/

# Real S3/Wasabi credentials live next to manifests but must never be committed.
# Templates live at *-creds.template and ARE tracked.
wasabi-creds
*-creds

# Phase 12 (SOPS-06): plaintext Secret defense-in-depth.
# Block any `secret-*.yaml` file that lacks the `.enc.yaml` suffix from being
# staged. Encrypted siblings (`secret-*.enc.yaml`) are explicitly negated below
# so they remain trackable. Pre-commit hooks (yuvipanda/ensure-sops + custom
# kind-detection backstop) complement this rule at hook-firing time; .gitignore
# complements them at file-pattern time. Both layers exist intentionally.
clusters/default/**/secret-*.yaml
# Also block suffixed plaintext (secret-x.yaml.new / .bak / .tmp). Both patterns
# above anchor on a .yaml ending, so a trailing suffix slipped past BOTH this
# ignore and the .sops.yaml path_regex. Near-miss 2026-09-04: a failed sops
# encrypt left secret-velero-repo-credentials.enc.yaml.new -- plaintext,
# untracked but NOT ignored, one `git add .` from being committed.
clusters/default/**/secret-*.yaml.*
!clusters/default/**/secret-*.enc.yaml
!clusters/default/**/secret-*.template

# ---- Hoarder / app secrets (audit class) ------------------------------------
*.secrets

# ---- Dotenv files (audit class) ---------------------------------------------
*.env
.env
.env.*

# ---- Terraform state (audit class) ------------------------------------------
*.tfstate
*.tfstate.*
.terraform/
*.tfvars

# ---- Ansible inventory (audit class) ----------------------------------------
inventory/hosts.ini
ansible/inventory/hosts.ini
ansible/inventory/host_vars/
ansible/inventory/group_vars/

# ---- Phase 3: cluster-vars deny + allow pair (M1 CFG-02) --------------------
# Real cluster-vars values applied out-of-band; example IS committed.
flux-system/cluster-vars.yaml
!flux-system/cluster-vars.example.yaml

# ---- Allowlist (re-include templates and examples) --------------------------
# Order matters: deny patterns above, allow patterns below.
!*-creds.template
!*.template
!*.example
!*.tfvars.example
!.env.example
!.env.*.example

# vim/editor swap + backup files — never commit these; a swapfile of a
# SOPS-managed secret lands editor buffer contents in git history.
*.swp
*.swo
*.swn
*~
.*.sw[a-p]
