# Template for the firefly-secrets Secret. NOT loaded by the flux kustomization —
# applied out-of-band (paloarp pattern) via:
#   ssh bastion@__K3S-API-IP__ 'sudo kubectl apply -f -' < this-file
#
# Generate values:
#   APP_KEY:         openssl rand -base64 32
#   POSTGRES_PASSWORD: openssl rand -base64 24 | tr -d '/+='
#   STATIC_CRON_TOKEN: openssl rand -hex 16   (32 chars, used by the cron sidecar)
apiVersion: v1
kind: Secret
metadata:
  name: firefly-secrets
  namespace: firefly
type: Opaque
stringData:
  APP_KEY: "REPLACE_ME_32_byte_base64"
  POSTGRES_PASSWORD: "REPLACE_ME_pg_password"
  STATIC_CRON_TOKEN: "REPLACE_ME_32_hex"
