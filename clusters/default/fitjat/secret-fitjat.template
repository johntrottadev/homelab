# Template for the fitjat-secrets Secret consumed by the fitjat Deployment
# via envFrom secretRef. The real Secret is gitignored (matches *-creds glob
# in /.gitignore). Apply out-of-band:
#
#   cp secret-fitjat.template secret-fitjat
#   # edit values
#   kubectl apply -f secret-fitjat
#
# fitjat is a personal fitness and journaling app (blueboy8888/fitjat) that
# uses GitHub OAuth for authentication. All key values come from the GitHub
# OAuth App registered in your GitHub account.
#
# GitHub OAuth App setup:
#   GitHub > Settings > Developer settings > OAuth Apps > New OAuth App
#   Authorization callback URL: https://fitjat.<your-domain>/api/auth/callback/github

apiVersion: v1
kind: Secret
metadata:
  name: fitjat-secrets
  namespace: fitjat
type: Opaque
stringData:
  GITHUB_CLIENT_ID: "REPLACE_ME"      # GitHub OAuth App > Client ID
  GITHUB_CLIENT_SECRET: "REPLACE_ME"  # GitHub OAuth App > Client secrets > Generate a client secret
  NEXTAUTH_SECRET: "REPLACE_ME"       # generate: openssl rand -base64 36
  # NEXTAUTH_URL is set via ConfigMap (fitjat-config) — not a secret.
  # If your deployment uses a DATABASE_URL or similar, add it here.
