# Template for the hoarder-secrets Secret consumed by the hoarder web and
# meilisearch Deployments via envFrom secretRef. The real Secret is gitignored
# (matches *-creds glob in /.gitignore). Apply out-of-band:
#
#   cp secret-hoarder.template secret-hoarder
#   # edit values
#   kubectl apply -f secret-hoarder
#
# hoarder is Karakeep (v0.31.0+), a self-hosted bookmarking app. The two active
# secret keys below are the only ones consumed at runtime. NEXT_PUBLIC_SECRET
# was dropped in Phase 1 (not read by any current Karakeep version). OAUTH_CLIENT_*
# for GitHub OAuth are only needed if you enable GitHub login.
#
# Value generation:
#   NEXTAUTH_SECRET:  openssl rand -base64 36
#   MEILI_MASTER_KEY: openssl rand -base64 36  (must match meilisearch startup)

apiVersion: v1
kind: Secret
metadata:
  name: hoarder-secrets
  namespace: hoarder
type: Opaque
stringData:
  NEXTAUTH_SECRET: "REPLACE_ME"       # generate: openssl rand -base64 36
  MEILI_MASTER_KEY: "REPLACE_ME"      # generate: openssl rand -base64 36; must match meilisearch env
  # Optional: GitHub OAuth (Karakeep v0.31+ uses OAUTH_CLIENT_* not GITHUB_*)
  # OAUTH_CLIENT_ID: "REPLACE_ME"     # GitHub OAuth App > Client ID
  # OAUTH_CLIENT_SECRET: "REPLACE_ME" # GitHub OAuth App > Client secrets
