# Template for the minio-root Secret. NOT loaded by the flux kustomization —
# applied out-of-band (paloarp pattern). Copy to minio-root.yaml (gitignored)
# with real values and `kubectl apply -f`.
apiVersion: v1
kind: Secret
metadata:
  name: minio-root
  namespace: minio
type: Opaque
stringData:
  MINIO_ROOT_USER: "mcadmin"
  MINIO_ROOT_PASSWORD: "REPLACE_ME_min_32_chars"
