# Template for the wasabi-creds Secret used by the replicate-wasabi
# CronJob. NOT loaded by the flux kustomization — applied out-of-band.
# Reuses the same Wasabi access keys as Velero (velero-wasabi-creds).
apiVersion: v1
kind: Secret
metadata:
  name: wasabi-creds
  namespace: minio
type: Opaque
stringData:
  ACCESS_KEY_ID: "REPLACE_ME"
  SECRET_ACCESS_KEY: "REPLACE_ME"
