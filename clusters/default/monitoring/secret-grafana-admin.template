# Template for the grafana-admin-credentials Secret consumed by the
# kube-prometheus-stack HelmRelease (Grafana). Apply out-of-band:
#
#   cp secret-grafana-admin.template secret-grafana-admin
#   # edit values
#   kubectl apply -f secret-grafana-admin
#
# The HelmRelease references this Secret via:
#   grafana.adminPassword.existingSecret: grafana-admin-credentials
#   grafana.adminPassword.passwordKey: admin-password
#   grafana.adminPassword.userKey: admin-user
#
# Value sources:
#   admin-user:     Choose any username (e.g., "admin")
#   admin-password: generate: openssl rand -base64 24 | tr -d '/+='

apiVersion: v1
kind: Secret
metadata:
  name: grafana-admin-credentials
  namespace: monitoring
type: Opaque
stringData:
  admin-user: "REPLACE_ME"      # Grafana admin username (e.g. "admin")
  admin-password: "REPLACE_ME"  # generate: openssl rand -base64 24 | tr -d '/+='
