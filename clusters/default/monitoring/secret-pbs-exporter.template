# Template for the backup-host-exporter-credentials Secret consumed by the backup-host-exporter
# Deployment via secretKeyRef. Apply out-of-band:
#
#   cp secret-backup-host-exporter.template secret-backup-host-exporter
#   # edit values
#   kubectl apply -f secret-backup-host-exporter
#
# The backup-host-exporter Deployment reads these keys:
#   username:     PBS_USERNAME  — the PBS user the API token belongs to
#   token-name:   PBS_API_TOKEN_NAME — API token name (the part after '!')
#   token-secret: PBS_API_TOKEN — API token secret value
#
# Create the API token in Proxmox Backup Server:
#   PBS web UI > Administration > API Tokens > Add
#   User: <your-user>@backup-host (or @pam)
#   Token Name: backup-host-exporter (or any label)
#   Privilege Separation: yes (limits scope to Datastore.Audit)
#   After creation, copy the full token ID (user@realm!name) and the secret value.
#
# Note: PBS_ENDPOINT (the PBS HTTPS URL) is a plain env var in the Deployment
# spec, not a secret — update it directly in clusters/default/monitoring/backup-host-exporter/deployment.yaml.

apiVersion: v1
kind: Secret
metadata:
  name: backup-host-exporter-credentials
  namespace: monitoring
type: Opaque
stringData:
  username: "REPLACE_ME"      # PBS API token owner, e.g. "monitoring@backup-host" or "root@pam"
  token-name: "REPLACE_ME"    # API token name (the label), e.g. "backup-host-exporter"
  token-secret: "REPLACE_ME"  # API token secret value (shown once at creation time)
