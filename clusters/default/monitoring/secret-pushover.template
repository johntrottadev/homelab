# Template for the pushover-creds Secret consumed by the kube-prometheus-stack
# HelmRelease (Alertmanager) and the fitjat backup health CronJob. Apply out-of-band:
#
#   cp secret-pushover.template secret-pushover
#   # edit values
#   kubectl apply -f secret-pushover
#
# Alertmanager mounts this Secret as a file volume and reads:
#   /etc/alertmanager/secrets/pushover-creds/token
#   /etc/alertmanager/secrets/pushover-creds/user_key
# Keys must match these exact file names (token, user_key).
#
# Value sources:
#   token:    Pushover.net > Your Applications > Register an Application > API Token
#   user_key: Pushover.net > Your User Key (shown on dashboard after login)

apiVersion: v1
kind: Secret
metadata:
  name: pushover-creds
  namespace: monitoring
type: Opaque
stringData:
  token: "REPLACE_ME"     # Pushover application API token (30 chars, starts with 'a')
  user_key: "REPLACE_ME"  # Pushover user/group key (30 chars, shown on dashboard)
