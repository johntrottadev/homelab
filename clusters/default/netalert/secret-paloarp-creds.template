# Template for the paloarp-credentials Secret consumed by the netalert
# Deployment via envFrom. The real Secret is gitignored (matches *-creds glob
# in /.gitignore). Apply out-of-band:
#
#   cp secret-paloarp-creds.template secret-paloarp-creds
#   # edit values
#   kubectl apply -f secret-paloarp-creds
#
# Generate the API key against the PA:
#   curl -k "https://<pa>/api/?type=keygen&user=<u>&password=<p>"
#
# NOTE: the netalert namespace is in the velero backup set, so this Secret is
# replicated to wasabi nightly. Either: scope velero to skip it, rotate keys
# regularly, or migrate to sealed-secrets. Today it's not encrypted at rest
# in the backup.

apiVersion: v1
kind: Secret
metadata:
  name: paloarp-credentials
  namespace: netalert
type: Opaque
stringData:
  PALO_HOST: "10.10.x.1"
  PALO_API_KEY: "REPLACE_ME"
  PALO_VERIFY_TLS: "false"
  # Optional — comma-separated, no spaces. Only emit ARP from these PA
  # interfaces (e.g. specific VLAN sub-interfaces). Leave unset for "all".
  # PALO_IFACE_INCLUDE: "ethernet1/2.10,ethernet1/2.20,ethernet1/2.30"
  # Optional — interfaces to drop (mgmt, tunnels, etc.).
  # PALO_IFACE_EXCLUDE: "tunnel.1,loopback.1"
