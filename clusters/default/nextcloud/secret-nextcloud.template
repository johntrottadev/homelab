# Template for the nextcloud-secrets Secret. NOT loaded by the flux
# kustomization — applied out-of-band, mirroring the netalert PALOARP
# pattern. Fill in the REPLACE_ME values and apply with:
#   kubectl apply -f secret-nextcloud.yaml
# (write a real ".yaml" copy, never commit it to git).
#
# Wasabi creds: extract from the existing velero-wasabi-creds secret.
# See README.md for the one-liner.
apiVersion: v1
kind: Secret
metadata:
  name: nextcloud-secrets
  namespace: nextcloud
type: Opaque
stringData:
  POSTGRES_PASSWORD: "REPLACE_ME_postgres_password_min_24_chars"
  NEXTCLOUD_ADMIN_USER: "admin"
  NEXTCLOUD_ADMIN_PASSWORD: "REPLACE_ME_admin_password_min_24_chars"
  OBJECTSTORE_S3_KEY: "REPLACE_ME_wasabi_access_key_id"
  OBJECTSTORE_S3_SECRET: "REPLACE_ME_wasabi_secret_access_key"
