# Template for the nextcloud-rclone-wasabi Secret. NOT loaded by the
# flux kustomization — applied out-of-band, paloarp pattern. Reuses the
# Wasabi access keys already provisioned for Velero (see
# velero/velero-wasabi-creds). Extract once with:
#
#   ssh bastion@__K3S-API-IP__ 'sudo kubectl get secret -n velero \
#     velero-wasabi-creds -o jsonpath="{.data.cloud}" | base64 -d'
#
# Output is an AWS-style credentials file; copy access_key_id and
# secret_access_key into the placeholders below.
apiVersion: v1
kind: Secret
metadata:
  name: nextcloud-rclone-wasabi
  namespace: nextcloud
type: Opaque
stringData:
  ACCESS_KEY_ID: "REPLACE_ME_wasabi_access_key_id"
  SECRET_ACCESS_KEY: "REPLACE_ME_wasabi_secret_access_key"
