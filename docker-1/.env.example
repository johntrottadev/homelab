# Per-host aggregated dotenv schema for docker-1 (Phase 3 / CFG-04 / D-11).
#
# Copy this file to /opt/komodo/.env (mode 0600) and fill in real values:
#   sudo cp docker-1/.env.example /opt/komodo/.env
#   sudo chmod 600 /opt/komodo/.env
#   sudo $EDITOR /opt/komodo/.env
#
# /opt/komodo/.env is the canonical per-host env-file referenced by
# docker-1/komodo-stack.yaml (env_file: /opt/komodo/.env). Komodo Periphery
# passes this same file to every stack via:
#   docker compose --env-file=/opt/komodo/.env up -d
#
# This file is gitignored via .gitignore *.env pattern from Phase 1 D-05.
# Never commit /opt/komodo/.env or any *.env file with real values.
#
# D-13 carve-out: stack-only secrets (qbittorrent's WireGuard key,
# wazuh's INDEXER_PASSWORD/API_PASSWORD) may live in per-stack files like
# /mnt/kub/homelab/qbittorrent/.env. The variable NAMES are listed below
# for operator discoverability; the actual VALUES may live in those
# per-stack files instead of /opt/komodo/.env. Either location works
# per the docker-compose interpolation precedence rules — shell env >
# CWD .env > --env-file flag.

# --- Site domain (mirrors root .env.example BASE_DOMAIN) ---
BASE_DOMAIN=__BASE-DOMAIN__

# --- Komodo (komodo-stack.yaml) ---
# komodo-stack.yaml uses ${KOMODO_DATABASE_USERNAME:?msg} / ${KOMODO_DATABASE_PASSWORD:?msg}
# These MUST be set or compose-up will fail loudly.
KOMODO_DATABASE_USERNAME=REPLACE_WITH_KOMODO_DB_USER
KOMODO_DATABASE_PASSWORD=REPLACE_WITH_KOMODO_DB_PASSWORD

# --- qbittorrent / WireGuard VPN (qbittorrent/compose.yaml) ---
# Per D-13: actual values may live at /mnt/kub/homelab/qbittorrent/.env;
# names listed here for schema discoverability.
VPN_SERVICE_PROVIDER=REPLACE_WITH_VPN_PROVIDER
VPN_TYPE=wireguard
WIREGUARD_PRIVATE_KEY=REPLACE_WITH_WG_PRIVATE_KEY
WIREGUARD_ADDRESSES=REPLACE_WITH_WG_ADDRESSES
SERVER_CITIES=REPLACE_WITH_SERVER_CITIES
DNS_ADDRESS=1.1.1.1
PUID=1000
PGID=1000
TZ=America/New_York
WEBUI_PORT=8080

# --- wazuh (wazuh/compose.yaml) ---
INDEXER_PASSWORD=REPLACE_WITH_INDEXER_PASSWORD
API_PASSWORD=REPLACE_WITH_API_PASSWORD

# --- legacy-vm (legacy-vm/compose.yaml) ---
VNC_PW=REPLACE_WITH_VNC_PW
