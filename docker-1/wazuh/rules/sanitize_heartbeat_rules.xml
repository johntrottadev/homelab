<!-- Sanitize-pipeline heartbeat rules (added 2026-05-23, field renamed to avoid Wazuh-reserved 'status') -->
<group name="sanitize-heartbeat,custom,">
  <rule id="100100" level="3">
    <decoded_as>json</decoded_as>
    <field name="check">sanitize-heartbeat</field>
    <description>Sanitize-pipeline heartbeat event ()</description>
  </rule>
  <rule id="100101" level="5">
    <if_sid>100100</if_sid>
    <field name="result">STALE</field>
    <description>Sanitize-pipeline STALE: public mirror older than threshold</description>
    <group>pci_dss_10.6.1,gdpr_IV_32.2,</group>
  </rule>
  <rule id="100102" level="7">
    <if_sid>100100</if_sid>
    <field name="result">ERROR</field>
    <description>Sanitize-pipeline ERROR: heartbeat check itself failed</description>
    <group>pci_dss_10.6.1,gdpr_IV_32.2,</group>
  </rule>
</group>
