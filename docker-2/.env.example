# Per-host aggregated dotenv schema for docker-2 (Phase 3 / CFG-04 / D-11).
#
# Copy to /opt/komodo/.env on docker-2 and fill in real values. Komodo
# Periphery on docker-2 invokes:
#   docker compose --env-file=/opt/komodo/.env up -d
#
# This file is gitignored via .gitignore *.env pattern from Phase 1 D-05.
#
# docker-2 currently runs only the lacus stack; this surface is small. If
# additional stacks are deployed to docker-2, append their variables here.

# --- Site domain (mirrors root .env.example BASE_DOMAIN) ---
BASE_DOMAIN=__BASE-DOMAIN__
