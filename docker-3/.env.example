# Per-host aggregated dotenv schema for docker-3 (Phase 11 11-01a / D-17).
#
# Copy to /opt/komodo/.env on docker-3 and fill in real values via openssl rand.
# NEVER commit /opt/komodo/.env — only this .example shape ships in repo.
# Per feedback_password_handling memory: never paste cleartext into chat.

# --- Site domain (mirrors root .env.example BASE_DOMAIN) ---
BASE_DOMAIN=__BASE-DOMAIN__

# --- Postgres / FerretDB DB credentials (internal only; no host port exposed) ---
KOMODO_DATABASE_USERNAME=admin
KOMODO_DATABASE_PASSWORD=REPLACE_WITH_KOMODO_DB_PASSWORD

# --- Komodo Core public-facing host (LAN/tailnet) — used for OAuth / webhook ---
KOMODO_HOST=http://__LAN-IP__:9120
KOMODO_TITLE=bastion-docker-3

# --- Local-auth bootstrap admin (rotate via UI on first login) ---
KOMODO_LOCAL_AUTH=true
KOMODO_INIT_ADMIN_USERNAME=admin
KOMODO_INIT_ADMIN_PASSWORD=REPLACE_WITH_ADMIN_INITIAL_PASSWORD
KOMODO_FIRST_SERVER_NAME=docker-3

# --- Random secrets for token signing + inbound webhook auth ---
KOMODO_JWT_SECRET=REPLACE_WITH_JWT_SECRET
KOMODO_WEBHOOK_SECRET=REPLACE_WITH_WEBHOOK_SECRET

# --- Sensible polling defaults ---
KOMODO_MONITORING_INTERVAL=15-sec
KOMODO_RESOURCE_POLL_INTERVAL=1-hr

# --- Lock down public registration ---
KOMODO_DISABLE_USER_REGISTRATION=true
TZ=America/New_York

# NOTE: This is the Core-only schema. docker-3 does NOT have an embedded
# Periphery (D-17). Periphery on docker-1/docker-2/app-vm runs as a systemd binary
# outbound to http://__LAN-IP__:9120 (D-01, D-18). KOMODO_PASSKEY and
# PERIPHERY_PASSKEYS are intentionally absent — v2 Ed25519 PKI replaces them.
