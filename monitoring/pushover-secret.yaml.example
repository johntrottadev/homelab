## Real Pushover credentials for Alertmanager. Do NOT commit a copy with
## actual values — keep that copy in /Volumes/code/secrets/homelab/monitoring/
## or apply it directly via stdin.
##
## Quick apply (replace placeholders, do not save the rendered version):
##   kubectl create secret generic pushover-creds -n monitoring \
##     --from-literal=user_key=USER_KEY_HERE \
##     --from-literal=token=APP_TOKEN_HERE \
##     --dry-run=client -o yaml | kubectl apply -f -
##
## The Alertmanager pod mounts this at /etc/alertmanager/secrets/pushover-creds/
## via `alertmanagerSpec.secrets: [pushover-creds]` in monitoring/values.yaml.
apiVersion: v1
kind: Secret
metadata:
  name: pushover-creds
  namespace: monitoring
type: Opaque
stringData:
  user_key: REPLACE_WITH_PUSHOVER_USER_KEY
  token: REPLACE_WITH_PUSHOVER_APP_TOKEN
