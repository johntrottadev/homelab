{
  // Renovate config for this repository (private origin; sanitize.yml
  // force-publishes a derived public mirror — see CLAUDE.md §Workflow).
  // Phase 14 (PIN-02). Locked decisions referenced as D-NN from
  // .planning/phases/14-image-digest-pinning-renovate/14-CONTEXT.md.

  $schema: 'https://docs.renovatebot.com/renovate-schema.json',

  extends: [
    'config:recommended',
  ],

  // Repository-level digest pinning. Cascades to docker-compose and
  // github-actions managers (both honor pinDigests). PIN-02.
  pinDigests: true,

  // ROADMAP impl note literals — PR-storm prevention on first run.
  // Defaults are 10 / 0; we explicitly clamp to 3 / 1.
  prConcurrentLimit: 3,
  prHourlyLimit: 1,

  // Three packageRules below use dependencyDashboardApproval, whose approval
  // surface IS the issue-based dependency dashboard. Repo issues were disabled,
  // so those majors were silently unapprovable — permanently blocked with no
  // visible queue. Issues re-enabled 2026-08-27; keep them on, or those rules
  // become a black hole again.
  dependencyDashboard: true,
  dependencyDashboardTitle: 'Renovate Dependency Dashboard',

  // Single-repo scope is enforced at the workflow level via
  // RENOVATE_REPOSITORIES env var (see .github/workflows/renovate.yml).
  // autodiscover left at default (false) for defense-in-depth.

  // D-01: enable docker-compose AND github-actions managers.
  // No `dockerfile` manager — periphery dirs ship config + systemd only.
  // docker-1/legacy-vm/ has a Dockerfile but the resulting image is local-only (D-07).
  // Renovate's default config already enables both managers; we extend them.

  // D-02: extend docker-compose manager's fileMatch / managerFilePatterns
  // to include Komodo Stack manifests (docker-1/komodo-stack.yaml,
  // docker-3/komodo-stack.yaml). We use `fileMatch` here because the locally
  // pip/npm-installed `renovate-config-validator` (Renovate v37 lineage)
  // does NOT yet accept `managerFilePatterns` as a key inside a manager
  // block, while the production runner uses
  // renovatebot/github-action@v46.1.14 which natively understands
  // `managerFilePatterns` AND auto-migrates legacy `fileMatch` to it on
  // load (Renovate config-migration §fileMatch -> managerFilePatterns).
  // `fileMatch` is therefore the forward-compatible spelling that
  // validates locally today and keeps working under the v46 action with
  // the auto-migration applied at runtime — both names work identically
  // at execution time per research §managerFilePatterns vs fileMatch.
  // Renovate's default docker-compose pattern set:
  //   /(^|/)(?:docker-)?compose[^/]*\.ya?ml$/
  // does NOT match `komodo-stack.yaml`. The Renovate docs §file-matching
  // confirm this list is ADDITIVE — our entry extends the defaults.
  // Both Komodo Stack files have standard top-level `services:` blocks
  // (verified by research §extract.ts), so docker-compose manager parses
  // them correctly. No regexManagers block needed.
  'docker-compose': {
    fileMatch: ['(^|/)komodo-stack\\.yaml$'],
  },

  // 2026-07-14: enable the `kubernetes` manager so raw Deployment/StatefulSet/
  // DaemonSet image pins under clusters/default/ get update PRs too — closing the
  // gap where only docker-compose images were tracked. Renovate's kubernetes
  // manager only extracts files containing a k8s `kind:` + `image:`, so a broad
  // fileMatch is safe (non-workload YAML is skipped). Flux HelmRelease chart
  // versions are handled by the built-in `flux` manager (config:recommended).
  kubernetes: {
    fileMatch: ['clusters/default/.+\\.ya?ml$'],
  },

  // D-01 (explicit-evidence half): make github-actions manager visible by
  // surface inspection of renovate.json5. `config:recommended` already
  // auto-enables this manager — the empty block below is defensive
  // documentation so D-01's "Enable Renovate's docker-compose AND
  // github-actions managers in renovate.json5" is satisfied literally,
  // not just transitively via the preset.
  'github-actions': {},

  // 2026-09-30: HelmRelease `spec.values` image overrides are NOT extracted by
  // the flux manager (it tracks chart versions only) nor by helm-values (which
  // reads standalone values.yaml files). Annotate such overrides with
  //   # renovate: datasource=docker depName=<registry/repo>
  // on the line directly above `tag: "<version>@sha256:<digest>"` and this
  // regex manager tracks both version and digest. First user: ciso-assistant.
  // `fileMatch` spelling kept for local-validator parity (see D-02 note).
  customManagers: [
    {
      customType: 'regex',
      description: 'Annotated image tags inside Flux HelmRelease values under clusters/default',
      fileMatch: ['clusters/default/.+\\.ya?ml$'],
      matchStrings: [
        '#\\s*renovate:\\s*datasource=(?<datasource>\\S+)\\s+depName=(?<depName>\\S+)\\s*\\n\\s*tag:\\s*"?(?<currentValue>[^@"\\s]+)(?:@(?<currentDigest>sha256:[a-f0-9]{64}))?"?',
      ],
    },
  ],

  // D-07: silently exclude jt-lab/* packages. Renovate already auto-skips
  // services with `build:` field (verified research §extract.ts), so
  // docker-1/legacy-vm/compose.yaml's `jt-lab/legacy-vm-kasm:1.0` line never enters
  // extraction. This rule is DEFENSIVE documentation — makes intent
  // explicit and survives any future refactor that might split `build:`
  // and `image:` across files.
  // D-08: backlog seed only — out of scope for Phase 14. PIN-04 will
  // migrate legacy-vm-kasm to ghcr.io so Renovate can track it like every
  // other image. Captured as a deferred forward-pointer only.
  packageRules: [
    {
      // Digest pinning for Kubernetes manifests (2026-09-30). The top-level
      // `pinDigests: true` already cascades to every manager; this rule makes
      // the clusters/ scope explicit so a future change to the global flag
      // (e.g. to quiet docker-compose) cannot silently drop k8s pinning.
      // Scoped by manager AND path, so docker-compose / github-actions are
      // untouched. Tag-only images get a "pin digest" PR; tag@sha256 images
      // get tag+digest bumps. Flux HelmRelease chart versions have no digest
      // field, so Renovate only pins where the manager supports it.
      matchManagers: ['kubernetes', 'flux', 'helm-values', 'custom.regex'],
      matchFileNames: ['clusters/default/**'],
      pinDigests: true,
      description: 'Pin image digests for Kubernetes/Flux manifests under clusters/default.',
    },
    {
      matchPackagePatterns: ['^jt-lab/'],
      enabled: false,
      description: 'D-07: jt-lab/* are local-build images; no upstream registry to pin. See PIN-04 backlog.',
    },
    {
      // GUARDRAIL: never auto-propose a DATABASE major bump. A postgres/redis/
      // mariadb major jump makes the on-disk data dir unreadable and takes the
      // app down — those upgrades need a manual dump/restore or pg_upgrade.
      // Renovate still offers minor/patch/digest for these; majors are blocked.
      matchDatasources: ['docker'],
      matchPackageNames: ['postgres', 'redis', 'mariadb', 'mysql', 'mongo'],
      matchUpdateTypes: ['major'],
      enabled: false,
      description: 'Block DB major bumps — data-dir incompatibility risk; do these by hand.',
    },
    {
      // Apps whose majors require sequential/manual upgrade steps: surface the
      // major as a dashboard entry needing explicit approval, don't open it as a
      // ready-to-merge PR. Minor/patch/digest still flow normally.
      matchPackageNames: [
        'nextcloud', 'guacamole/guacamole', 'guacamole/guacd', 'fireflyiii/core',
        // ciso-assistant v4 (chart 0.12.x+) is a new app major — read notes first.
        'ghcr.io/intuitem/ciso-assistant-community/backend',
        'ghcr.io/intuitem/ciso-assistant-community/frontend',
        'ciso-assistant',
      ],
      matchUpdateTypes: ['major'],
      dependencyDashboardApproval: true,
      description: 'Major upgrades for stateful apps need manual approval (schema/upgrade steps).',
    },
    {
      // Everything else: group minor+patch+digest into tidy per-manager PRs so
      // "keep images current" is a small review, not a PR storm.
      matchUpdateTypes: ['minor', 'patch', 'digest'],
      groupName: 'image updates (non-major)',
    },
  ],

  // Deferred to backlog (intentionally omitted; documented for future planners):
  //   RNV-01: grouped digest updates + business-hours schedule.
  //   RNV-02: automerge for digest-only PRs (after 2-4 week observation).
  //   RNV-03: hostRules for registry.community.greenbone.net.
  //           D-05 explicitly defers — ship Phase 14 with ZERO hostRules
  //           entries; D-06's empirical-first-run protocol may pull it forward
  //           as Phase 14.1 hotfix only if greenbone digest resolution errors
  //           on the first Renovate run AND no other manager produces PRs.
}
