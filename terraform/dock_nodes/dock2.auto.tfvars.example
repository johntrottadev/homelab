# Copy to docker-2.auto.tfvars (gitignored) and adjust if/when adding more dock nodes.
#
# The docker-2 spec mirrors docs/operator/MIRROR-PLAN.md as of 2026-05-01:
#   target_node = __PVE-NODE-3__   (auto-picked: not docker-1's host __PVE-NODE-1__; __PVE-NODE-2__ has k3s-5)
#   ip          = __LAN-IP__
#   sizing      = 4 vCPU / 16 GiB / 100 GiB (defaults, can be omitted)
#
# docker-3 spec per D-17 (Phase 11 11-01a): __PVE-NODE-2__ / __LAN-IP__ / 4 vCPU / 8 GiB / 60 GiB
#   (Core-only — smaller than docker-1/docker-2 default; no workload stacks on docker-3).

nodes = {
  docker-2 = {
    target_node = "__PVE-NODE-3__"
    ip          = "__LAN-IP__"
  }
  docker-3 = {
    # Phase 11 11-01a (D-17): runs Komodo Core v2 only — no workloads —
    # so the default 4 vCPU / 16 GiB / 100 GiB is oversized. Override here.
    target_node = "__PVE-NODE-2__"
    ip          = "__LAN-IP__"
    cores       = 4
    memory      = 8192
    disk_size   = "60G"
  }
}
